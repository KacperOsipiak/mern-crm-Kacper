# Maak een .env bestand en kopieer dit bestand naar .env en vul je eigen waarden in

# Server configuratie
PORT=4000

# MongoDB connection string (uit MongoDB Atlas)
# Format: mongodb+srv://GEBRUIKERSNAAM:WACHTWOORD@CLUSTER.mongodb.net/DATABASE
# Vul je eigen connection string in van MongoDB Atlas
MONGO_URI=

# Development of production
NODE_ENV=development